GOGUIDE_DSN=goguide:goguide@tcp(127.0.0.1:3306)/goguide?parseTime=true&charset=utf8mb4
GOGUIDE_ADDR=:8080
GOGUIDE_JWT_SECRET=replace-with-at-least-32-random-characters
GOGUIDE_PAYMENT_SECRET=replace-with-a-different-32-character-secret
GOGUIDE_ADMIN_EMAIL=admin@example.test
GOGUIDE_ADMIN_PASSWORD=replace-before-exposing-server
DEEPSEEK_API_KEY=
# DeepSeek V4.1 Flash 的模型标识为 deepseek-flash；使用 DeepSeek API Key 时可省略以下两项。
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
